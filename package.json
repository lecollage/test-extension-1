{
  "name": "chrome-extension-wxt-ts-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "ci": "npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "spec:new": "node scripts/new-spec.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:staged": "prettier --write",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install",
    "zip": "wxt zip",
    "postinstall": "wxt prepare"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "3.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.18",
    "wxt": "^0.20.6"
  }
}
